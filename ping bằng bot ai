# ===== 1. Lấy access token =====
def get_access_token():
    url = "https://openapi.seatalk.io/auth/app_access_token"
    headers = {"Content-Type": "application/json"}
    payload = {"app_id": APP_ID, "app_secret": APP_SECRET}
    res = requests.post(url, headers=headers, json=payload)
    data = res.json()
    if res.status_code == 200 and data.get("code") == 0:
        print("✅ Lấy token thành công")
        return data["app_access_token"]
    else:
        print("❌ Lỗi khi lấy token:", data)
        return None

# ===== 2. Lấy employee_code từ nhiều email =====
def get_employee_codes_from_emails(token, emails):
    url = "https://openapi.seatalk.io/contacts/v2/get_employee_code_with_email"
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json"
    }
    payload = {"emails": emails}
    res = requests.post(url, headers=headers, json=payload)
    data = res.json()
    print("📦 Response:", data)

    email_to_code = {}
    if res.status_code == 200 and data.get("code") == 0:
        for emp in data.get("employees", []):
            if emp.get("employee_code") and emp.get("employee_status") == 2:
                email_to_code[emp["email"]] = emp["employee_code"]
    return email_to_code

